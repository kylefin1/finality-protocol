{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finalitygroup.com/schemas/falsification-report.schema.json",
  "title": "Outside Falsification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportType",
    "schemaVersion",
    "reviewer",
    "release",
    "repository",
    "commit",
    "methods",
    "attacks",
    "falseFinalObserved",
    "stopBypassObserved",
    "verifierDiscrepancies",
    "limitations",
    "createdAt"
  ],
  "properties": {
    "reportType": { "const": "OUTSIDE_FALSIFICATION_REPORT" },
    "schemaVersion": { "const": "1.0" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity", "independenceDisclosure"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "organization": { "type": "string" },
        "identity": { "type": "string", "minLength": 3 },
        "independenceDisclosure": { "type": "string", "minLength": 1 }
      }
    },
    "release": { "const": "FRP-2.0.0-draft.1-20260829" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactHashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "uniqueItems": true
    },
    "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "threatModel": { "type": "string" },
    "attacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "attempted", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "attempted": { "type": "boolean" },
          "result": {
            "enum": [
              "FALSE_FINAL_OBSERVED",
              "STOP_BYPASS_OBSERVED",
              "VERIFIER_DISCREPANCY",
              "OTHER_SECURITY_FINDING",
              "NO_LISTED_FAILURE_OBSERVED_WITHIN_SCOPE",
              "NOT_EXECUTED"
            ]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "falseFinalObserved": { "type": "integer", "minimum": 0 },
    "stopBypassObserved": { "type": "integer", "minimum": 0 },
    "verifierDiscrepancies": { "type": "integer", "minimum": 0 },
    "successfulAttacks": { "type": "array", "items": { "type": "string" } },
    "failedAttacks": { "type": "array", "items": { "type": "string" } },
    "securityFindings": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
