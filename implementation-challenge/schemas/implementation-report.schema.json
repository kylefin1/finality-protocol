{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finalitygroup.com/schemas/implementation-report.schema.json",
  "title": "Independent Implementation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportType",
    "schemaVersion",
    "authors",
    "independenceDisclosure",
    "repository",
    "commit",
    "artifactSha256",
    "ciRunUrl",
    "release",
    "language",
    "reusedCode",
    "conformanceResultSha256",
    "limitations",
    "createdAt"
  ],
  "properties": {
    "reportType": { "const": "INDEPENDENT_IMPLEMENTATION_REPORT" },
    "schemaVersion": { "const": "1.0" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "organization": { "type": "string" },
    "independenceDisclosure": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ciRunUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/.+/actions/runs/" },
    "release": { "const": "FRP-2.0.0-draft.1-20260829" },
    "language": { "type": "string", "minLength": 1 },
    "reusedCode": { "type": "array", "items": { "type": "string" } },
    "finalityClarification": { "type": "array", "items": { "type": "string" } },
    "conformanceResultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "discrepancies": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
