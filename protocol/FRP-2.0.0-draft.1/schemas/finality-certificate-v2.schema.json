{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finalitygroup.com/protocol/v2/schemas/finality-certificate-v2.schema.json",
  "title": "Finality Outcome Certificate v2",
  "type": "object",
  "required": ["protocol", "protocolVersion", "certificateType", "certificateId", "outcomeContractHash", "subject", "requestedOutcome", "sourceContractHashes", "observationCommitments", "evidenceRoot", "dependencyGraphRoot", "temporalEvaluation", "contradictions", "classification", "kernelVersion", "previousCertificate", "supersessionReason", "reopenPolicyHash", "issuedAt", "signatures", "verificationMaterial", "certificateHash"],
  "properties": {
    "protocol": {"const": "finality-reality"}, "protocolVersion": {"type": "string"}, "certificateType": {"const": "FinalityOutcomeCertificateV2"}, "certificateId": {"type": "string"}, "outcomeContractHash": {"$ref": "#/$defs/hash"}, "subject": {"type": "object"}, "requestedOutcome": {"type": "object"},
    "sourceContractHashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}, "observationCommitments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}, "evidenceRoot": {"$ref": "#/$defs/hash"}, "dependencyGraphRoot": {"$ref": "#/$defs/hash"}, "temporalEvaluation": {"type": "object"}, "contradictions": {"type": "array"},
    "classification": {"enum": ["OPEN", "PENDING", "FINAL", "CONTRADICTED", "CURE_REQUIRED", "FAILED", "REOPENED", "SUPERSEDED"]}, "kernelVersion": {"type": "string"}, "previousCertificate": {"type": ["string", "null"]}, "supersessionReason": {"type": ["string", "null"]}, "reopenPolicyHash": {"$ref": "#/$defs/hash"}, "issuedAt": {"type": "string", "format": "date-time"},
    "signatures": {"type": "array", "items": {"type": "object", "required": ["algorithm", "keyId", "signature"], "properties": {"algorithm": {"type": "string"}, "keyId": {"type": "string"}, "signature": {"type": "string"}}, "additionalProperties": false}},
    "verificationMaterial": {"type": "object"}, "certificateHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "additionalProperties": false
}
